# Loaded by pgdemo-server (OPENSSL_CONF). OpenSSL applies it when oatpp-openssl
# creates the SSL_CTX, so the server never names groups itself.
#
# X25519MLKEM768 and X25519 come from OpenSSL 3.5's default provider, so a
# stock client still connects. The later names are liboqs groups that OpenSSL
# 3.5 does not implement; a client that offers one of them can negotiate it.
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect
ssl_conf = ssl_sect

[provider_sect]
default = default_sect
oqsprovider = oqsprovider_sect

[default_sect]
activate = 1

[oqsprovider_sect]
activate = 1

[ssl_sect]
system_default = tls_sect

[tls_sect]
MinProtocol = TLSv1.3
Groups = X25519MLKEM768:X25519:x25519_mlkem512:x25519_hqc1
