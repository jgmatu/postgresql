# Build trees
/build*/
/out/
compile_commands.json

# Runtime state: JWT keys, generated passwords, logs, pid files
/run/
/docker/.env
/docker/operational/.env

# Control panel: dependencies, Next build output, the licensed Catalyst kit
# (copied in by frontend/scripts/setup-catalyst.sh), and the built panel, which
# CI publishes as an artifact instead (scripts/fetch-webroot.sh).
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/next-env.d.ts
/frontend/tsconfig.tsbuildinfo
/frontend/src/components/catalyst/
/webroot/*
!/webroot/README.md

# Python virtual environment for the Robot Framework e2e suite
/.venv/
__pycache__/
*.pyc

# Editors and language servers
.cache/
.vscode/
.idea/
*.swp
